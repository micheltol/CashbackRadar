{
  "manifest_version": 3,
  "name": "CashbackRadar",
  "short_name": "CashbackRadar",
  "version": "1.2.0",
  "description": "Ziet of de site die je bezoekt cashback heeft bij ShopBuddies of CashbackXL, en waar die het hoogst is. Onofficieel.",
  "homepage_url": "https://github.com/micheltol/CashbackRadar",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://shopbuddies.nl/*", "https://www.cashbackxl.nl/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CashbackRadar",
    "default_icon": {
      "16": "icons/inactive-16.png",
      "32": "icons/inactive-32.png",
      "48": "icons/inactive-48.png"
    }
  },
  "icons": {
    "16": "icons/active-16.png",
    "32": "icons/active-32.png",
    "48": "icons/active-48.png",
    "128": "icons/active-128.png"
  }
}
